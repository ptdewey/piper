# Server configuration
SERVER_PORT=8080
SERVER_HOST=localhost

SERVER_ROOT_URL=

# Enable music services
ENABLE_SPOTIFY=true
ENABLE_LASTFM=true
ENABLE_LISTENBRAINZ=true
ENABLE_APPLEMUSIC=true

# Spotify OAuth configuration
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_AUTH_URL=https://accounts.spotify.com/authorize
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token
SPOTIFY_SCOPES=user-read-currently-playing user-read-email

# ATProto OAuth configuration
# link to metadata url
ATPROTO_CLIENT_ID=
ATPROTO_METADATA_URL=
ATPROTO_CALLBACK_URL=
ATPROTO_CLIENT_SECRET_KEY={goat key generate -t P-256}
ATPROTO_CLIENT_SECRET_KEY_ID={can be whatever usually a timestamp}

# Last.fm
LASTFM_API_KEY=

# ListenBrainz
LISTENBRAINZ_API_URL=https://api.listenbrainz.org
LISTENBRAINZ_INTERVAL_SECONDS=30

# Callback URLs
CALLBACK_SPOTIFY=

# Tracker settings
TRACKER_INTERVAL=30

# Database settings
DB_PATH=./piper.db

# Allowed DIDs
ALLOWED_DIDS=

# OpenTelemetry (optional). Piper exports traces and metrics over OTLP/gRPC
# only when a common or signal-specific endpoint is configured.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=piper
# OTEL_TRACES_SAMPLER=parentbased_always_on
# Set true to disable telemetry even when an endpoint is configured.
# OTEL_SDK_DISABLED=false
